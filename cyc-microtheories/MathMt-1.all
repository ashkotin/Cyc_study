hol-variable-map: ?var0 -> f; ?var1..4 -> v1..4; t,u are fresh intermediate values
hol:
theory MathMt_69975
  imports Main
begin

typedecl value

type_synonym partial_binary = "value \<Rightarrow> value \<Rightarrow> value option"

consts
  AssociativeRelation :: "partial_binary \<Rightarrow> bool"
  EvaluatableFunction :: "partial_binary \<Rightarrow> bool"

definition MathMt_L69975 :: bool where
  "MathMt_L69975 \<longleftrightarrow>
    (\<forall>(f :: partial_binary) v1 v2 v3 v4.
       (AssociativeRelation f \<and> EvaluatableFunction f \<and>
        (\<exists>t. f v3 v4 = Some t \<and> f v2 t = Some v1))
       \<longrightarrow> (\<exists>u. f v2 v3 = Some u \<and> f u v4 = Some v1))"

end
hol-end:
[/unit MathMt_L69975]

