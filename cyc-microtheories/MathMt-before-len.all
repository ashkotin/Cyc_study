    (\<forall>(v0 :: cyc_value) (v1 :: cyc_value). (((CycRealNumber v0) \<and> (CycRealNumber v1)) \<longrightarrow> ((v0 = v1) \<or> (CycGreaterThan v0 v1) \<or> (CycGreaterThan v1 v0))))"
isb-end:
