definition MathMt_L59085 :: bool where
  "MathMt_L59085 \<longleftrightarrow>
    (\<forall>(v0 :: cyc_value) (v1 :: cyc_value) (v2 :: cyc_value) (v3 :: cyc_value) (v4 :: cyc_value) (v5 :: cyc_value) (v6 :: cyc_value) (v7 :: cyc_value). (((CycRealNumber v0) \<and> (CycRealNumber v1) \<and> (CycRealNumber v2) \<and> (CycPlusValue v1 v2 v3) \<and> (CycTimesValue v0 v3 v4) \<and> (CycPlusValue v6 v7 v5) \<and> (CycTimesValue v0 v1 v6) \<and> (CycTimesValue v0 v2 v7)) \<longrightarrow> (v5 = v4)))"
isb-end:
[/unit MathMt_L59085]

